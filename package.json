{
  "name": "weekly-recipe-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3001",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/start.mjs",
    "start:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1 --port 3002",
    "typecheck": "tsc --noEmit --incremental false",
    "provision:browser": "playwright install chromium",
    "test": "npm run typecheck && PLANNER_PUBLIC_BASE_PATH=/recipe-planner/ npm run build && node scripts/run-node-tests.mjs",
    "test:e2e": "playwright test",
    "qa:serve": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/qa-portless-runtime.mjs",
    "planner:global": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/planner-global-client.ts",
    "planner:migrate-v8-v9": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate-planner-store-v8-to-v9.ts",
    "planner:migrate-v9-v10": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate-planner-store-v9-to-v10.ts",
    "probe:codex-follow-up": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/probe-codex-follow-up.mjs",
    "probe:release-lifecycle": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/probe-release-lifecycle.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/vite-plugin": "1.51.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "6.15.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "image-size": "file:packages/image-size-adapter",
    "portless": "0.13.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.120.1"
  },
  "overrides": {
    "vinext": {
      "image-size": "$image-size"
    }
  },
  "type": "module"
}
